<Page
    x:Class="InteropTools.ShellPages.Gofly.RingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:InteropTools.ShellPages.Gofly"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="TitleTextBlockStyle4" TargetType="TextBlock" 
       BasedOn="{StaticResource BaseTextBlockStyle}">
            <Setter Property="FontWeight" Value="SemiLight"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings"/>
            <Setter Property="Margin" Value="0,5,0,18" />
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock
                    Margin="{x:Bind Frame.Padding, Mode=OneWay}"
                    DataContext="{x:Bind Frame}"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Insider Rings"
                    TextWrapping="Wrap"
                    Visibility="{Binding PageTitleVisibility}" />

        <Pivot Grid.Row="1" Margin="{x:Bind Frame.Padding, Mode=OneWay}">
            <PivotItem Header="Client">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource TitleTextBlockStyle3}" Text="BRANCH" />
                        <TextBlock Margin="0,6,0,0" Text="Production" />
                        <TextBlock x:Name="BrClientProd" TextWrapping="Wrap" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                        <TextBlock Margin="0,6,0,0" Text="Insider Release Preview" />
                        <TextBlock x:Name="BrClientIRP" TextWrapping="Wrap" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                        <TextBlock Margin="0,6,0,0" Text="Microsoft IT" />
                        <TextBlock x:Name="BrClientMSIT" TextWrapping="Wrap" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                        <TextBlock Margin="0,6,0,0" Text="Windows Insider Slow" />
                        <TextBlock x:Name="BrClientWIS" TextWrapping="Wrap" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                        <TextBlock Margin="0,6,0,0" Text="Windows Insider Fast" />
                        <TextBlock x:Name="BrClientWIF" TextWrapping="Wrap" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>

                        <TextBlock Style="{StaticResource TitleTextBlockStyle3}" Text="ACTIVE DEVELOPMENT" />
                        <TextBlock Margin="0,6,0,0" Text="Production" />
                        <TextBlock x:Name="ActiveClientProd" TextWrapping="Wrap" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                        <TextBlock Margin="0,6,0,0" Text="Insider Release Preview" />
                        <TextBlock x:Name="ActiveClientIRP" TextWrapping="Wrap" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                        <TextBlock Margin="0,6,0,0" Text="Microsoft IT" />
                        <TextBlock x:Name="ActiveClientMSIT" TextWrapping="Wrap" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                        <TextBlock Margin="0,6,0,0" Text="Windows Insider Slow" />
                        <TextBlock x:Name="ActiveClientWIS" TextWrapping="Wrap" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                        <TextBlock Margin="0,6,0,0" Text="Windows Insider Fast" />
                        <TextBlock x:Name="ActiveClientWIF" TextWrapping="Wrap" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>

                        <TextBlock Style="{StaticResource TitleTextBlockStyle3}" Text="SKIP AHEAD" />
                        <TextBlock Margin="0,6,0,0" Text="Production" />
                        <TextBlock x:Name="SkipClientProd" TextWrapping="Wrap" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                        <TextBlock Margin="0,6,0,0" Text="Insider Release Preview" />
                        <TextBlock x:Name="SkipClientIRP" TextWrapping="Wrap" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
