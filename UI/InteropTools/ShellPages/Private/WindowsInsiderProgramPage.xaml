<Page
    x:Class="InteropTools.ShellPages.Private.WindowsInsiderProgramPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:InteropTools.ShellPages.Private"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer Padding="{x:Bind Frame.Padding, Mode=OneWay}" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,12">
                <TextBlock
                    DataContext="{x:Bind Frame}"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Windows Insider Program"
                    TextWrapping="Wrap"
                    Visibility="{Binding PageTitleVisibility}" />
                <StackPanel
                    Height="auto"
                    MaxWidth="430"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                    <StackPanel Visibility="Visible">
                        <TextBlock Style="{StaticResource TitleTextBlockStyle3}" Text="SYSTEM TRAIN MANAGER" />
                        <ToggleSwitch
                            x:Name="TrainManagerToggle"
                            Header="Set Interop Tools as the Default System Train Manager"
                            IsOn="false"
                            Toggled="TrainManagerToggle_Toggled" />
                    </StackPanel>
                    <StackPanel
                        x:Name="MainPanel"
                        Margin="0,24,0,0"
                        IsDoubleTapEnabled="False"
                        IsHitTestVisible="False"
                        IsHoldingEnabled="False"
                        IsRightTapEnabled="False"
                        IsTapEnabled="False"
                        Opacity="0.5">
                        <StackPanel x:Name="Production" Visibility="Visible">
                            <TextBlock Style="{StaticResource TitleTextBlockStyle3}" Text="GET INSIDER PREVIEW BUILDS" />
                            <TextBlock
                                Margin="0,1,0,0"
                                Style="{StaticResource ParagraphTextBlockStyle}"
                                Text="Set up your device if you want to participate in the Windows Insider Program, and start receiving prerelease software and services from Microsoft." />
                            <Button
                                Margin="0,8,0,16"
                                Click="Button_Click"
                                Content="Get Insider Preview builds" />
                        </StackPanel>
                        <StackPanel x:Name="NonProduction" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource TitleTextBlockStyle3}" Text="GET INSIDER PREVIEW BUILDS" />
                            <TextBlock
                                Margin="0,1,0,0"
                                Style="{StaticResource ParagraphTextBlockStyle}"
                                Text="You are all set to receive Insider Preview builds." />
                            <Button
                                Margin="0,8,0,16"
                                Click="Button_Click_1"
                                Content="Stop Insider Preview builds" />
                            <TextBlock
                                Margin="0,18,0,8"
                                Style="{StaticResource TitleTextBlockStyle3}"
                                Text="CHOOSE YOUR INSIDER LEVEL" />
                            <TextBlock
                                x:Name="RingDescription"
                                Margin="0,4,0,8"
                                Style="{StaticResource ParagraphTextBlockStyle}"
                                Text="Best for Insiders who enjoy being the first to identify issues, provide suggestions, and ideas to make Windows devices great." />
                            <ComboBox
                                x:Name="RingSelector"
                                Width="280"
                                HorizontalAlignment="Left"
                                SelectionChanged="RingSelector_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding UpdateTrainName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock
                                Margin="0,24,0,0"
                                Style="{StaticResource TitleTextBlockStyle3}"
                                Text="CHOOSE YOUR BRANCH" />
                            <HyperlinkButton
                                Margin="0,6,0,6"
                                Content="To change your branch, use WPSHIFT"
                                NavigateUri="http://aka.ms/wpshift_wiki">
                                <HyperlinkButton.ContentTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" />
                                    </DataTemplate>
                                </HyperlinkButton.ContentTemplate>
                            </HyperlinkButton>
                            <ComboBox
                                Width="280"
                                Margin="0,8,0,8"
                                HorizontalAlignment="Left"
                                IsEnabled="False"
                                SelectedIndex="0">
                                <ComboBoxItem Content="Release Branch for Retail" />
                            </ComboBox>
                            <TextBlock
                                Margin="0,18,0,8"
                                Style="{StaticResource ParagraphTextBlockStyle}"
                                Text="Note: It will take some time to receive a build after changing your settings." />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel
                    Height="auto"
                    MaxWidth="430"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                    <TextBlock Style="{StaticResource TitleTextBlockStyle3}" Text="WINDOWS INSIDER ACCOUNT" />
                    <ListView
                        Width="430"
                        Margin="-8,-8,0,0"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollMode="Auto"
                        SelectionMode="None">
                        <ListViewItem>
                            <StackPanel Orientation="Horizontal">
                                <Image
                                    Width="40"
                                    Height="40"
                                    Margin="0,8,8,8"
                                    Source="ms-appx:///Assets/microsoft_logo.png" />
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="donasa@microsoft.com" />
                                    <TextBlock Opacity="0.75" Text="Microsoft Account" />
                                </StackPanel>
                            </StackPanel>
                        </ListViewItem>
                    </ListView>
                    <HyperlinkButton Margin="0,8,0,8" NavigateUri="windows-feedback:?contextid=220">
                        <HyperlinkButton.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        Text="" />
                                    <TextBlock VerticalAlignment="Center" Text="Give us your feedback about this page" />
                                </StackPanel>
                            </DataTemplate>
                        </HyperlinkButton.ContentTemplate>
                    </HyperlinkButton>
                </StackPanel>
                <StackPanel
                    Height="auto"
                    MaxWidth="430"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                    <TextBlock Style="{StaticResource TitleTextBlockStyle3}" Text="DIAGNOSTICS" />

                    <TextBlock Text="Use Windows Update" />
                    <TextBlock
                        x:Name="UseWUtxt"
                        Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                        TextWrapping="Wrap" />

                    <TextBlock Margin="0,6,0,0" Text="Category ID" />
                    <TextBlock
                        x:Name="CatIDtxt"
                        Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                        TextWrapping="Wrap" />

                    <TextBlock Margin="0,6,0,0" Text="Detection Url 1" />
                    <TextBlock
                        x:Name="Detect1txt"
                        Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                        TextWrapping="Wrap" />

                    <TextBlock Margin="0,6,0,0" Text="Detection Url 2" />
                    <TextBlock
                        x:Name="Detect2txt"
                        Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                        TextWrapping="Wrap" />

                    <TextBlock Margin="0,6,0,0" Text="Threshold Flighting Enabled" />
                    <TextBlock
                        x:Name="THFlighttxt"
                        Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                        TextWrapping="Wrap" />

                    <TextBlock Margin="0,6,0,0" Text="OS Version Greater or Equal to" />
                    <TextBlock
                        x:Name="OSGEtxt"
                        Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                        TextWrapping="Wrap" />

                    <TextBlock Margin="0,6,0,0" Text="Test Target" />
                    <TextBlock
                        x:Name="TestTrgttxt"
                        Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                        TextWrapping="Wrap" />

                    <TextBlock Margin="0,6,0,0" Text="Update Train Name" />
                    <TextBlock
                        x:Name="TrainNametxt"
                        Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                        TextWrapping="Wrap" />

                    <TextBlock Margin="0,6,0,0" Text="UUP Scan Enabled" />
                    <TextBlock
                        x:Name="UUPScanEnabledtxt"
                        Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                        TextWrapping="Wrap" />

                    <TextBlock Margin="0,6,0,0" Text="Supports UUP" />
                    <TextBlock
                        x:Name="SupportsUUPtxt"
                        Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
